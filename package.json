{
  "name": "twitter-auto-spam-crawler",
  "version": "0.0.0",
  "description": "A userscript that automatically crawls tweets on Twitter/X. Designed to be used with Blue Blocker.",
  "homepage": "https://github.com/book000/twitter-auto-spam-crawler",
  "bugs": {
    "url": "https://github.com/book000/twitter-auto-spam-crawler/issues/new"
  },
  "license": "MIT",
  "author": "Tomachi",
  "main": "dist/twitter-auto-spam-crawler.user.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/book000/twitter-auto-spam-crawler.git"
  },
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --mode=development --watch",
    "test": "jest --runInBand --passWithNoTests --detectOpenHandles --forceExit --coverage",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:tsc": "tsc --noEmit",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.122",
    "@types/greasemonkey": "4.0.7",
    "@types/jest": "30.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "run-z": "2.1.0",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "type": "module",
  "userscript": {
    "namespace": "https://tomacheese.com",
    "match": [
      "https://x.com/*",
      "https://example.com/*"
    ],
    "icon": "https://www.google.com/s2/favicons?sz=64&domain=x.com",
    "updateURL": "https://github.com/book000/twitter-auto-spam-crawler/releases/latest/download/twitter-auto-spam-crawler.user.js",
    "downloadURL": "https://github.com/book000/twitter-auto-spam-crawler/releases/latest/download/twitter-auto-spam-crawler.user.js",
    "grant": [
      "GM_getValue",
      "GM_setValue",
      "GM_registerMenuCommand",
      "GM_unregisterMenuCommand"
    ],
    "require": "https://update.greasyfork.org/scripts/470224/1303666/Tampermonkey%20Config.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testTimeout": 120000,
    "fakeTimers": {
      "enableGlobally": true
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/types/**/*",
      "!src/**/*.test.ts",
      "!src/__mocks__/**/*",
      "!src/__tests__/**/*"
    ]
  }
}
